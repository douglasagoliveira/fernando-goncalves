---
import { Image, Picture } from "astro:assets"
import MainLayout from "../layouts/MainLayout.astro"
import Arrow from "../components/Arrow.astro"
import SectionHeader from "../components/SectionHeader.astro"
import Testimonials from "../components/Testimonials.astro"
import CtaBanner from "../components/CtaBanner.astro"
import retrato from "../assets/fernando-recorte.png"
import sala from "../assets/fernando-sala.webp"
import simplexLogo from "../assets/simplex-branco.png"
import { audiences, results } from "../data/content"
---

<MainLayout path="/">
  {/* ------------------------------------------------------------- HERO */}
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy hero-animate">
        <p class="eyebrow">
          <span class="eyebrow__index">01</span>
          <span>Storyteller e palestrante motivacional</span>
        </p>
        <h1>
          Transforme <i>adversidades</i> em força.
        </h1>
        <p class="hero__sub">
          Transforme pessoas em <span class="text-accent">protagonistas</span>.
        </p>
        <p class="lead">
          Desde 1992, Fernando Gonçalves utiliza sua própria história de vida
          para inspirar pessoas, despertar a autoconsciência e estimular
          mudanças de atitude.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/palestras">Conheça meu trabalho <Arrow /></a>
          <a class="btn btn--ghost" href="/contato">Solicite uma palestra</a>
        </div>
      </div>

      <div class="hero__figure hero-figure">
        <Picture
          src={retrato}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[420, 640, 860]}
          sizes="(max-width: 900px) 72vw, 40vw"
          alt="Fernando Gonçalves sentado, com microfone na mão, durante uma palestra"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="hero__portrait"
        />
        <p class="hero__badge glass">
          <span class="hero__badge-value">1992</span>
          <span class="hero__badge-label">
            o ano da primeira palestra
          </span>
        </p>
      </div>
    </div>

    <div class="container">
      <dl class="hero__stats">
        <div class="stat" data-reveal data-reveal-index="1">
          <dt class="stat__label">Anos de atuação</dt>
          <dd class="stat__value" data-count="30" data-count-prefix="+">+30</dd>
        </div>
        <div class="stat" data-reveal data-reveal-index="2">
          <dt class="stat__label">Momentos por palestra</dt>
          <dd class="stat__value">3</dd>
        </div>
        <div class="stat" data-reveal data-reveal-index="3">
          <dt class="stat__label">História real, muitos recomeços</dt>
          <dd class="stat__value">1</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* ---------------------------------------------------- IDENTIFICAÇÃO */}
  <section class="section section--tall" id="historia">
    <div class="container manifesto">
      <figure class="manifesto__media" data-reveal="mask">
        <Picture
          src={sala}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[520, 760, 1100]}
          sizes="(max-width: 900px) 92vw, 46vw"
          alt="Fernando Gonçalves em um auditório, antes de uma palestra"
          loading="lazy"
          data-parallax
        />
        <figcaption>Uma voz que começa pela escuta</figcaption>
      </figure>

      <div class="manifesto__copy">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__index">02</span>
          <span>A identificação</span>
        </p>
        <h2 data-reveal style="--reveal-delay:80ms">
          Você não escolhe todas as circunstâncias. <i
            >Mas escolhe como enfrentá-las.</i
          >
        </h2>
        <p class="body-text" data-reveal style="--reveal-delay:150ms">
          Pobreza, doenças na infância, bullying, violência, dificuldades
          familiares e limitações educacionais fizeram parte da caminhada de
          Fernando. Mas a história não terminou aí: ele decidiu que as
          circunstâncias não determinariam quem ele seria.
        </p>
        <p class="body-text" data-reveal style="--reveal-delay:200ms">
          Hoje, depois de décadas dedicadas à comunicação, ao desenvolvimento
          humano e à motivação, ele leva a empresas, instituições e grupos uma
          mensagem direta — construída sobre experiência, e não sobre fórmulas
          mágicas.
        </p>
        <a class="text-link" href="/sobre" data-reveal style="--reveal-delay:260ms">
          Conheça a trajetória completa <Arrow />
        </a>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- SIMPLEX */}
  <section class="section section--raised" id="metodo">
    <div class="container simplex">
      <div class="simplex__copy">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__index">03</span>
          <span>O método</span>
        </p>
        <h2 data-reveal style="--reveal-delay:80ms">
          Uma palestra não precisa ser <i>igual</i> para todas as empresas.
        </h2>
        <p class="body-text" data-reveal style="--reveal-delay:150ms">
          O SIMPLEX — Sistema Motivacional para Performances de Excelência — é a
          metodologia que estrutura a experiência de acordo com o perfil da
          organização, os objetivos da contratação e as características do
          público. Do planejamento à avaliação, com relatórios de participação
          depois do encontro.
        </p>
        <a class="text-link" href="/palestras#simplex" data-reveal style="--reveal-delay:220ms">
          Entenda o método e os formatos <Arrow />
        </a>
      </div>

      <div class="simplex__mark" data-reveal style="--reveal-delay:120ms">
        <Image
          src={simplexLogo}
          alt="SIMPLEX — Sistema Motivacional para Performances de Excelência"
          widths={[220, 440]}
          sizes="220px"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- PÚBLICOS */}
  <section class="section" id="publicos">
    <div class="container">
      <SectionHeader
        index="04"
        eyebrow="Para quem"
        title="Diferentes públicos. Uma mesma proposta: <i>despertar pessoas.</i>"
        align="between"
        intro="As palestras são adaptadas ao contexto de quem recebe — do chão de fábrica à convenção de vendas."
      />
      <ul class="audience-grid">
        {
          audiences.map((item, i) => (
            <li class="card" data-reveal data-reveal-index={(i % 4) + 1}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------- DEPOIMENTOS */}
  <Testimonials index="05" />

  {/* --------------------------------------------------------- RESULTADOS */}
  <section class="section section--raised" id="resultados">
    <div class="container">
      <SectionHeader
        index="06"
        eyebrow="Resultados"
        title="O que uma experiência motivacional <i>pode despertar.</i>"
        intro="Motivação não substitui gestão, planejamento ou estratégia. Mas ajuda pessoas a reencontrarem o propósito necessário para colocar tudo isso em prática."
      />
      <ol class="results-grid">
        {
          results.map((item, i) => (
            <li data-reveal data-reveal-index={(i % 3) + 1}>
              <span class="results-grid__index">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBanner />
</MainLayout>

<style>
  /* ------------------------------------------------------------- hero */
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 1rem + 6vw, 5.5rem);
    padding-bottom: var(--space-xl);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: var(--space-xl);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .hero__copy h1 {
    max-width: 11ch;
  }

  .hero__sub {
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-title);
    color: var(--color-muted);
  }

  .hero__copy .lead {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .hero__figure {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 40rem;
  }

  .hero__figure :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 48px 60px rgba(3, 8, 15, 0.65));
    mask-image: linear-gradient(180deg, #000 86%, transparent 99%);
  }

  .hero__badge {
    position: absolute;
    left: -2%;
    bottom: 14%;
    z-index: 2;
    display: grid;
    gap: 0.2rem;
    padding: var(--space-sm) var(--space-md);
    background: rgba(6, 13, 25, 0.78);
  }

  .hero__badge-value {
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .hero__badge-label {
    font-size: var(--text-xs);
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .hero__stats .stat {
    flex-direction: column-reverse;
  }

  /* -------------------------------------------------------- manifesto */
  .manifesto {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .manifesto__media {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--hairline);
  }

  .manifesto__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 34% center;
  }

  .manifesto__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: var(--space-md);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-text);
    background: linear-gradient(0deg, rgba(3, 8, 15, 0.85), transparent);
  }

  .manifesto__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .manifesto__copy h2 i {
    color: var(--color-muted);
  }

  /* ---------------------------------------------------------- simplex */
  .simplex {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .simplex__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .simplex__mark {
    justify-self: center;
  }

  .simplex__mark :global(img) {
    width: clamp(10rem, 18vw, 13.75rem);
    height: auto;
    opacity: 0.95;
  }

  /* --------------------------------------------------------- públicos */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }

  /* -------------------------------------------------------- resultados */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }

  .results-grid li {
    display: grid;
    gap: var(--space-2xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .results-grid__index {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .results-grid p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: 34ch;
  }

  /* ------------------------------------------------------ responsivo */
  @media (max-width: 1100px) {
    .audience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }

    .hero__copy {
      max-width: none;
    }

    .hero__figure {
      justify-self: center;
      max-width: 20rem;
    }

    .hero__badge {
      left: auto;
      right: 0;
      bottom: 6%;
    }

    .manifesto,
    .simplex {
      grid-template-columns: minmax(0, 1fr);
    }

    .simplex__mark {
      justify-self: start;
    }
  }

  @media (max-width: 640px) {
    .hero__badge {
      position: static;
      justify-items: start;
      margin-top: var(--space-sm);
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0;
      backdrop-filter: none;
    }

    .hero__badge-label {
      white-space: normal;
    }

    .hero__stats {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-sm);
    }

    .hero__stats .stat {
      flex-direction: row-reverse;
      align-items: baseline;
      justify-content: flex-end;
      gap: var(--space-sm);
    }

    .hero__stats .stat__value {
      font-size: 2rem;
    }

    .audience-grid,
    .results-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
