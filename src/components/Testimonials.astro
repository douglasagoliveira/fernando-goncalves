---
import { Image } from "astro:assets"
import { testimonials } from "../data/testimonials"
import SectionHeader from "./SectionHeader.astro"

interface Props {
  index?: string
}
const { index = "05" } = Astro.props
---

<section class="section section--line" id="depoimentos">
  <div class="container">
    <SectionHeader
      index={index}
      eyebrow="Depoimentos"
      title="Quem vive a experiência <i>pode contar melhor.</i>"
      align="between"
    >
      <div class="testimonials-controls">
        <p class="lead">
          Empresas, instituições e equipes que já receberam a palestra.
        </p>
        <div class="testimonials-nav">
          <button
            type="button"
            class="nav-circle"
            data-testimonials-control="prev"
            aria-label="Depoimentos anteriores"
            hidden
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5"></path>
            </svg>
          </button>
          <button
            type="button"
            class="nav-circle"
            data-testimonials-control="next"
            aria-label="Próximos depoimentos"
            hidden
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path>
            </svg>
          </button>
        </div>
      </div>
    </SectionHeader>
  </div>

  <div class="testimonials-viewport">
    <ul
      class="testimonials"
      data-testimonials
      tabindex="0"
      role="group"
      aria-label="Depoimentos — role horizontalmente para ver todos"
    >
      {
        testimonials.map((item) => (
          <li class="testimonial">
            <blockquote>
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="testimonial__author">
              <Image
                src={item.photo}
                alt={`Fotografia de ${item.name}`}
                width={56}
                height={56}
                loading="lazy"
                densities={[1, 2]}
              />
              <span>
                <b>{item.name}</b>
                <small>{item.role}</small>
              </span>
            </figcaption>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .testimonials-nav {
    display: flex;
    gap: var(--space-2xs);
  }

  .nav-circle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .nav-circle:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .nav-circle:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .testimonials-viewport {
    position: relative;
  }

  .testimonials {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(min(21rem, 78vw), 24rem);
    gap: var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    padding-block: 0.5rem var(--space-md);
    scrollbar-width: thin;
    scrollbar-color: var(--hairline-strong) transparent;
    overscroll-behavior-x: contain;
  }

  .testimonials::-webkit-scrollbar {
    height: 3px;
  }

  .testimonials::-webkit-scrollbar-thumb {
    background: var(--hairline-strong);
    border-radius: var(--radius-full);
  }

  .testimonial {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      165deg,
      rgba(26, 49, 89, 0.34),
      rgba(9, 20, 38, 0.15)
    );
  }

  .testimonial blockquote p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
  }

  .testimonial blockquote p::before {
    content: "“";
    display: block;
    font-size: 2.5rem;
    line-height: 0.6;
    margin-bottom: 0.75rem;
    color: var(--brand-teal);
  }

  .testimonial__author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
  }

  .testimonial__author img {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    object-fit: cover;
    filter: saturate(0.9);
  }

  .testimonial__author span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .testimonial__author b {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .testimonial__author small {
    font-size: var(--text-xs);
    color: var(--color-faint);
  }

  @media (min-width: 1240px) {
    .testimonials {
      padding-inline: max(var(--gutter), (100vw - var(--container-max)) / 2);
      scroll-padding-inline: max(
        var(--gutter),
        (100vw - var(--container-max)) / 2
      );
    }
  }
</style>
