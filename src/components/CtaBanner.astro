---
import Arrow from "./Arrow.astro"
import { site } from "../data/site"

interface Props {
  title?: string
  text?: string
  primaryLabel?: string
  primaryHref?: string
}

const {
  title = "Sua equipe precisa de motivação?<br /><i>Vamos conversar.</i>",
  text = "Palestras, treinamentos, eventos e projetos motivacionais personalizados para empresas, instituições e organizações.",
  primaryLabel = "Solicitar proposta",
  primaryHref = "/contato",
} = Astro.props
---

<section class="section cta">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 data-reveal set:html={title} />
      <p class="lead" data-reveal style="--reveal-delay:90ms">{text}</p>
    </div>
    <div class="cta__actions" data-reveal style="--reveal-delay:160ms">
      <a class="btn" href={primaryHref}>{primaryLabel} <Arrow /></a>
      <a class="btn btn--ghost" href={site.whatsapp} rel="noopener">
        WhatsApp {site.phoneLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: end;
    gap: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--hairline);
  }

  .cta__copy h2 {
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
  }

  .cta__copy .lead {
    margin-top: var(--space-md);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .cta__inner {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .cta__actions {
      justify-content: flex-start;
    }
  }
</style>
