---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { pageSeo, type PagePath } from "../data/site"
import "../styles/global.css"

interface Props {
  path: PagePath
  title?: string
  description?: string
  noindex?: boolean
}

const { path, noindex = false } = Astro.props
const seo = pageSeo[path]
const title = Astro.props.title ?? seo.title
const description = Astro.props.description ?? seo.description
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo principal</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/enhance"
    </script>
  </body>
</html>
